# Container versions
N8N_VERSION=2.36.8
POSTGRES_VERSION=18.6

# PostgreSQL administrator and n8n metadata database
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-a-random-secret
POSTGRES_DB=n8n

# Restricted n8n database role
POSTGRES_NON_ROOT_USER=n8n_app
POSTGRES_NON_ROOT_PASSWORD=replace-with-a-different-random-secret

# Restricted TalentAI application role (talentai_app)
TALENTAI_DB_PASSWORD=replace-with-a-different-random-secret

# n8n runtime secrets
RUNNERS_AUTH_TOKEN=replace-with-a-random-secret
N8N_ENCRYPTION_KEY=replace-with-a-stable-random-secret

# Local-only ports and timezone
N8N_HOST_PORT=5678
POSTGRES_HOST_PORT=5434
GENERIC_TIMEZONE=Asia/Tehran
